# Alter 配置模板 —— 复制为 .env 后填写
# 切换 AWS 账号时：只改这里的 AWS_PROFILE，代码不用动。

# ── AWS 账号（账号无关设计的关键）──────────────────
# 个人账号：先在终端跑 `aws configure --profile alter-personal` 填 Access Key
# 公司内部账号：走内部 SSO 拿临时凭证，profile 名按内部工具生成的填
AWS_PROFILE=alter-personal
AWS_REGION=us-east-1

# ── Bedrock 模型 ──────────────────────────────────
# POC 用便宜的 Haiku；换模型只改这一行
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# ── 内容源（POC 阶段：合规的公开 RSS）──────────────
# 多个源用逗号分隔
RSS_FEEDS=https://example.com/feed.xml

# ── 草稿风格（喂给大模型的提示，可随时调）──────────
COMMENT_TONE=专业、有见地、简洁，像一个懂行的从业者在真诚评论
COMMENT_MAX_WORDS=80
